# Copy to /etc/systemd/system/scheduler.service and replace the paths below with
# your project root and the output of `which python` inside your venv.
[Unit]
Description=Task Scheduler
After=network.target mongodb.service mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/py-starter
Environment="PYTHONPATH=/home/ubuntu/apps/py-starter"
# src.schedule.tasks = your module that registers tasks and calls `await scheduler.start()`
ExecStart=/home/ubuntu/apps/py-starter/.venv/bin/python -m src.schedule.tasks
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scheduler

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
